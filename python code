from flask import Flask, Response, render_template, jsonify
import cv2
import numpy as np
from twilio.rest import Client
import time

app = Flask(__name__)

# ====== Twilio Credentials ======
# Replace the placeholders with your own Twilio SID and Auth Token
account_sid = "YOUR_TWILIO_ACCOUNT_SID"
auth_token = "YOUR_TWILIO_AUTH_TOKEN"
client = Client(account_sid, auth_token)

# Replace with your phone numbers
to_number = "YOUR_PHONE_NUMBER"
from_number = "YOUR_TWILIO_PHONE_NUMBER"

# ====== Fire Detection Variables ======
fire_detected = False
message_sent = False
last_message_sent_time = time.time()

# ====== Location (Hidden for GitHub) ======
# You can configure your monitored location here
latitude = "YOUR_LATITUDE"
longitude = "YOUR_LONGITUDE"

# ====== YOLOv3 Model (Optional Advanced Detection) ======
net = cv2.dnn.readNet("yolov3.weights", "yolov3-fire.cfg")
classes = []
with open("fire_classes.txt", "r") as f:  # Use a generic file with fire classes
    classes = [line.strip() for line in f.readlines()]

layer_names = net.getLayerNames()
output_layers = [layer_names[i - 1] for i in net.getUnconnectedOutLayers()]

# ====== Camera Setup ======
cap = cv2.VideoCapture(0)
cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)

# ====== Helper Functions ======
def get_location():
    """Return the monitored location coordinates."""
    return latitude, longitude

def send_message(location):
    """Send SMS alert using Twilio when fire is detected."""
    global last_message_sent_time
    lat, lon = location
    maps_url = f"https://www.google.com/maps?q={lat},{lon}"
    video_url = "YOUR_LIVE_VIDEO_URL"  # Placeholder for live video feed link

    message_body = (
        f"Fire detected! Location: Lat {lat}, Lon {lon}. "
        f"Google Maps: {maps_url}. Live Video: {video_url}"
    )

    # Send message
    message = client.messages.create(
        body=message_body,
        from_=from_number,
        to=to_number
    )
    print("Message sent:", message.sid)
    last_message_sent_time = time.time()

def generate_frames():
    """Capture video frames and detect fire in real-time."""
    global fire_detected, message_sent

    while True:
        ret, frame = cap.read()
        if not ret:
            continue

        frame = cv2.resize(frame, (640, 480))
        hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)

        # Simple red detection (fire approximation)
        lower_red = np.array([0, 100, 100])
        upper_red = np.array([10, 255, 255])
        mask = cv2.inRange(hsv, lower_red, upper_red)
        mask = cv2.erode(mask, None, iterations=2)
        mask = cv2.dilate(mask, None, iterations=2)

        contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        largest_area = 0
        largest_contour = None

        for contour in contours:
            area = cv2.contourArea(contour)
            if area > largest_area:
                largest_area = area
                largest_contour = contour

        if largest_contour is not None:
            x, y, w, h = cv2.boundingRect(largest_contour)
            cv2.rectangle(frame, (x, y), (x + w, y + h), (0,0,255), 2)

            if largest_area > 1000 and not message_sent:
                fire_detected = True
                message_sent = True
                send_message(get_location())
            elif largest_area < 1000 and message_sent and time.time() - last_message_sent_time > 30:
                message_sent = False
                fire_detected = False
        else:
            fire_detected = False

        # Overlay location on video
        cv2.putText(frame, f"Lat: {latitude}, Lon: {longitude}", (10,30),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0,255,0), 2)

        _, buffer = cv2.imencode('.jpg', frame)
        frame_bytes = buffer.tobytes()
        yield (b'--frame\r\n'
               b'Content-Type: image/jpeg\r\n\r\n' + frame_bytes + b'\r\n')

# ====== Flask Routes ======
@app.route('/')
def index():
    return render_template('Website.html')

@app.route('/video_feed')
def video_feed():
    return Response(generate_frames(),
                    mimetype='multipart/x-mixed-replace; boundary=frame')

@app.route('/fire_status')
def fire_status():
    global fire_detected
    return jsonify({"fire_detected": fire_detected})

if __name__ == '__main__':
    app.run(host='0.0.0.0', port=5000, debug=True)
